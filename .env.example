# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxx

# 模型选择（可选，默认 deepseek-chat）
# deepseek-chat      - DeepSeek-V3，性价比最高，推荐日常使用
# deepseek-reasoner  - DeepSeek-R1，推理能力更强，回复更慢但更精准
DEEPSEEK_MODEL=deepseek-chat

# 闲鱼卖家昵称（可选，用于判断哪些消息是自己发的）
SELLER_NICKNAME=
